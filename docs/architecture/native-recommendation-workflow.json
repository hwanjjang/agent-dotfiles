  "cards": [
    {
      "dot": "cyan",
      "title": "Existing execution, separate review",
      "items": [
        "Preflight requires explicit authorization and current qualification; the recommendation command launches no trial.",
        "Recorded development and held-out reports are recomputed; raw commit/tree/blob bytes bind full materialized arm inventories."
      ]
    },
    {
      "dot": "amber",
      "title": "Limited same-host claim",
      "items": [
        "Selected trusted-maintainer receipts support not-supplied-to-author during the fixed comparison, not hostile same-UID secrecy.",
        "Known exposure blocks or reclassifies; unavailable delivery stays unknown. Source/record drift invalidates the result."
      ]
    },
    {
      "dot": "rose",
      "title": "Conformance is not actual benefit",
      "items": [
        "Positive CLI conformance uses FAKE lifecycle, qualification, clock, tool and remote-anchor evidence. No actual held-out comparison is claimed.",
        "A real reject or inconclusive is a valid endpoint. Source acceptance, merge and account installation require separate authority."
      ]
    }
  ]
