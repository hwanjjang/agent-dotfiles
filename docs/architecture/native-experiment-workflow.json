  "cards": [
    {
      "dot": "cyan",
      "title": "Conservative accounting",
      "items": [
        "Initial-turn reservations are not provider wire calls; all failed and missing reservations remain charged.",
        "Declared setup, task and cleanup time is never returned. Observed cumulative tokens are post-use soft accounting."
      ]
    },
    {
      "dot": "amber",
      "title": "Failure preserves evidence",
      "items": [
        "Crashes, incomplete cleanup and unknown or conflicting usage block further launches without refund.",
        "A complete native run may settle cost even when its task artifact is wrong or capture failed."
      ]
    },
    {
      "dot": "rose",
      "title": "Current scope",
      "items": [
        "A cooperating trusted-host gate, not a global account or hard provider quota. No natural-routing admission in this component.",
        "Current qualification refuses changed sources. Positive gate checks use explicitly synthetic lifecycle journals; no actual model inference is claimed."
      ]
    }
