    {
      "dot": "cyan",
      "title": "Attribution rules",
      "items": [
        "One row per changed component: helped, hurt, no observed effect or confounded.",
        "Prefer confounded for several components or one repetition; adoption or rejection alone proves nothing."
      ]
    },
    {
      "dot": "amber",
      "title": "Boundaries",
      "items": [
        "Records stay private; only sanitized examples are published under docs/evidence.",
        "Held-out and grade-derived material never enter the index; a lesson never authorizes promotion or installation."
      ]
    }
