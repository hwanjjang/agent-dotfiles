{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex run_sh.py session-start.sh",
            "statusMessage": "Loading planning context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex run_sh.py user-prompt-submit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex pre_tool_use.py",
            "statusMessage": "Checking plan before tool use"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex permission_request.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex post_tool_use.py",
            "statusMessage": "Reviewing changes against plan"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex run_sh.py pre-compact.sh",
            "statusMessage": "Preparing planning context before compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/bin/planning-hook.py\" codex stop.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
